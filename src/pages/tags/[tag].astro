---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const tags = [...new Set(posts.flatMap((post) => post.data.tags ?? []))];

  return tags.map((tag) => {
    const filteredPosts = posts
      .filter((post) => post.data.tags?.includes(tag))
      .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

    return {
      params: { tag },
      props: { posts: filteredPosts },
    };
  });
}

const { tag } = Astro.params;
const { posts } = Astro.props;

const renderedPosts = await Promise.all(
  posts.map(async (post) => {
    const { Content } = await render(post);
    const cleanBody = post.body.replace(/!\[.*?\]\(.*?\)/g, '').trim();
    const excerpt = cleanBody.slice(0, 180).trim();
    return { post, Content, excerpt };
  })
);
---

<BaseLayout title={`Posts tagged "${tag}"`}>
  <main class="container">
    <nav class="back">
      <a href="/">← Back</a>
    </nav>

    <h1 class="tag-heading">Posts tagged "{tag}"</h1>

    <section class="feed">
      {renderedPosts.map(({ post, Content, excerpt }) => (
        <article class="feed-card">
          <div class="feed-emoji">{post.data.emoji}</div>
          <div class="feed-body">
            <div class="feed-meta">
              {post.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
            </div>

            {post.data.type === 'long' ? (
              <div>
                {post.data.image && (
                  <img src={post.data.image} alt={post.data.title} class="feed-image" />
                )}
                <h2 class="feed-title">
                  <a href={`/posts/${post.id.replace(/\.md$/, '')}`}>{post.data.title}</a>
                </h2>
                <p class="feed-excerpt">{excerpt}...</p>
                <a href={`/posts/${post.id.replace(/\.md$/, '')}`} class="feed-more">Read more →</a>
              </div>
            ) : (
              <div class="feed-short"><Content /></div>
            )}

            {post.data.tags && (
              <div class="tag-row">
                {post.data.tags.map((t) => (
                  <a href={`/tags/${encodeURIComponent(t)}`} class="tag">{t}</a>
                ))}
              </div>
            )}
          </div>
        </article>
      ))}
    </section>
  </main>
</BaseLayout>

<style>
  .back {
    padding: 2rem 0 0;
  }
  .back a {
    font-size: 13px;
    color: var(--text-muted);
  }
  .back a:hover {
    color: var(--accent-violet);
  }
  .tag-heading {
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin: 1.5rem 0 2rem;
  }
  .feed {
    padding-bottom: 4rem;
  }
  .feed-card {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    background: var(--surface);
    border: 0.5px solid var(--border);
    border-radius: 10px;
    padding: 1rem 1.25rem;
    margin-bottom: 0.75rem;
  }
  .feed-emoji {
    font-size: 22px;
    flex-shrink: 0;
    margin-top: 2px;
  }
  .feed-body {
    flex: 1;
    min-width: 0;
  }
  .feed-meta {
    font-size: 11px;
    color: var(--text-muted);
    margin-bottom: 4px;
  }
  .feed-image {
    width: 100%;
    border-radius: 8px;
    margin-bottom: 10px;
    display: block;
    max-height: 320px;
    object-fit: cover;
  }
  .feed-title {
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 6px;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .feed-title a {
    color: var(--text-primary);
  }
  .feed-title a:hover {
    color: var(--accent-violet);
  }
  .feed-excerpt {
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.6;
  }
  .feed-more {
    display: inline-block;
    font-size: 12px;
    color: var(--accent-violet);
    margin-top: 6px;
  }
  .feed-more:hover {
    color: var(--accent-pink);
  }
  .feed-short {
    font-size: 15px;
    color: var(--text-secondary);
    line-height: 1.6;
  }
  .tag-row {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-top: 8px;
  }
  .tag {
    font-size: 11px;
    background: #1e0e33;
    color: var(--accent-violet);
    border-radius: 99px;
    padding: 2px 10px;
    text-decoration: none;
  }
  .tag:hover {
    color: var(--accent-pink);
  }
</style>
